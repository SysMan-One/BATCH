#
#  BATCH - files excluded from version control.
#

#  Build trees
build/
build-*/
cmake-build-*/
out/

#  Compilation and link products
*.o
*.a
*.so
*.so.*
*.gcno
*.gcda
*.gcov

#  Files generated at configuration time; inside the source tree when the build was run there
batchvers.h
/cmake/uninstall.cmake
/etc/batchd.service
/etc/batchd.init

#  CMake working files, in case the build was run inside the source tree
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json

#  Temporary and editor files
*~
*.orig
*.rej
*.swp
*.swo
.cache/
.vscode/
.idea/
core
core.*

#  Byte-compiled Python of the rendering script
__pycache__/
*.pyc

#  Kits: the build tree and the output of packaging/build.sh
build-pkg/
dist/

#  Products of a build inside the source tree
/src/Makefile
/test/Makefile
/src/batch
/src/batchd
/test/batch_queue
/test/*.log
